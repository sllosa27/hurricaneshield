# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Check Google's current model list and change this if needed
GEMINI_MODEL=gemini-2.5-flash
PORT=8787

# Auth0 login (dashboard: Applications > HurricaneShield, and Applications > APIs)
# Server: checks login tokens
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://hurricaneshield-api
# Browser: Vite only exposes variables that start with VITE_
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://hurricaneshield-api

# Tiger Data (Tiger Cloud service connection string). SECRET: contains a password.
# Optional: without it, checks still work and the trend chart says "connect Tiger Data".
DATABASE_URL=postgres://user:password@host:port/tsdb?sslmode=require
